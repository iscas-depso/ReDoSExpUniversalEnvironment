{
  "name": "redos-exp-universal-environment",
  "version": "0.3.0",
  "description": "ReDoS testing environment with web interface",
  "private": true,
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon --watch server --watch public --ext js,json,html server/index.js",
    "test": "npm run test:unit && npm run test:integration && npm run test:grewia:real && npm run test:e2e:docker",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:grewia:real": "bash scripts/test-grewia-real.sh",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:docker": "bash scripts/run-playwright-docker.sh",
    "test:quick": "npm run test:unit && npm run test:integration",
    "lint": "node --check server/*.js && node --check public/main.js"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "express": "^4.19.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "nodemon": "^3.1.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
