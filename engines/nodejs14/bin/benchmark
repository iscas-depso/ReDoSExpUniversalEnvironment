#!/bin/bash
# Node.js 14 Benchmark Wrapper (prefer absolute node path, fallback to nvm, then PATH)
set -euo pipefail
export PATH="/usr/local/bin:/home/developer/.nvm/versions/node/v21.7.3/bin:/home/developer/.nvm/versions/node/v14.21.3/bin:$PATH"
export NVM_DIR="/home/developer/.nvm"
DIR="$(cd "$(dirname "$0")" && pwd)"
SCRIPT_DIR="$(dirname "$DIR")"

NODE_BIN="$NVM_DIR/versions/node/v14.21.3/bin/node"
if [ -x "$NODE_BIN" ]; then
  exec "$NODE_BIN" "$SCRIPT_DIR/benchmark.js" "$@"
fi

# Try absolute symlinked binary inside container, if present
if [ -x "/usr/local/bin/node14" ]; then
  exec "/usr/local/bin/node14" "$SCRIPT_DIR/benchmark.js" "$@"
fi
if [ -x "/usr/local/bin/node" ]; then
  exec "/usr/local/bin/node" "$SCRIPT_DIR/benchmark.js" "$@"
fi

if [ -f "$NVM_DIR/nvm.sh" ]; then
  # shellcheck source=/dev/null
  . "$NVM_DIR/nvm.sh" >/dev/null 2>&1 || true
  nvm use 14.21.3 >/dev/null 2>&1 || true
fi

exec node "$SCRIPT_DIR/benchmark.js" "$@"


